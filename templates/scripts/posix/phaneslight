#!/bin/sh
# phaneslight-template v3.8.0 phaneslight
# Dispatcher. Routes `phaneslight <subcommand> [args]` to the sibling script in this directory.
# Resolves siblings by this script's own location, so it works from any working directory.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ "$#" -lt 1 ]; then
  # ENUMERATED from this directory, never hardcoded (v3.8.0). Both dispatchers used to carry a
  # hand-maintained list and the two had already drifted: this one named hook-ledger-status and
  # the Windows one did not. Nothing in the build could see the difference, which is exactly why
  # it survived. A list derived from the directory cannot disagree with the directory.
  # Excluded: the hook-* scripts, which the harness fires on tool calls and which are not user
  # subcommands. The dispatcher itself has no .sh suffix, so the glob never offers it.
  names=''
  for f in "$here"/*.sh; do
    [ -f "$f" ] || continue
    b=$(basename -- "$f" .sh)
    case "$b" in
      hook-*) continue ;;
      phaneslight) continue ;;
    esac
    names="$names $b"
  done
  echo "phaneslight: subcommands:$names"
  exit 0
fi

sub=$1
shift

# There is no by-name refusal block any more (v3.7.2). It existed because the v3.4 bootstrap
# set was Windows only and a deferred command needed to refuse rather than look like a typo;
# all ten now have POSIX siblings, so an unknown name falls through to the unknown-subcommand
# refusal below, which is where a typo belongs.

if [ -f "$here/$sub.sh" ]; then
  exec sh "$here/$sub.sh" "$@"
elif [ -f "$here/$sub" ]; then
  exec sh "$here/$sub" "$@"
else
  echo "phaneslight: unknown subcommand '$sub' (no $sub.sh in $here)" >&2
  exit 1
fi
