{
  "version": "3.8.0",
  "description": "PhanesLight template library. Reference implementations of the language-independent scripts, fetched by the install run and installed verbatim into .phaneslight/scripts/, plus (v3.3) the prompt templates fetched on every platform into .claude/template/. Scripts read .phaneslight/config.json at runtime and use project-relative paths only, so no per-project substitution is performed; prompt templates take no substitution either, they are instantiated by the run, never edited.",
  "installDir": ".phaneslight/scripts",
  "migrationBoundaries": ["3.5.0", "3.7.0"],
  "sanityStamp": "phaneslight-template v3.8.0 <name>",
  "sanityStampWithinFirstLines": 2,
  "scripts": [
    { "name": "cli",              "role": "dispatcher", "windows": ["scripts/cli.js"],                        "posix": ["scripts/cli.js"] },
    { "name": "phaneslight",           "role": "dispatcher", "windows": ["scripts/windows/phaneslight.ps1", "scripts/windows/phaneslight.cmd"], "posix": ["scripts/posix/phaneslight"] },
    { "name": "new-file",         "role": "command",    "windows": ["scripts/windows/new-file.ps1"],         "posix": ["scripts/posix/new-file.sh"] },
    { "name": "loc-check",        "role": "command",    "windows": ["scripts/windows/loc-check.ps1"],        "posix": ["scripts/posix/loc-check.sh"] },
    { "name": "doc-check",        "role": "command",    "windows": ["scripts/windows/doc-check.ps1"],        "posix": ["scripts/posix/doc-check.sh"] },
    { "name": "register-check",   "role": "command",    "windows": ["scripts/windows/register-check.ps1"],   "posix": ["scripts/posix/register-check.sh"] },
    { "name": "anchor-check",     "role": "command",    "windows": ["scripts/anchor-check.js", "scripts/windows/anchor-check.ps1"], "posix": ["scripts/anchor-check.js", "scripts/posix/anchor-check.sh"] },
    { "name": "doc-index",        "role": "command",    "windows": ["scripts/windows/doc-index.ps1"],        "posix": ["scripts/posix/doc-index.sh"] },
    { "name": "module-list",      "role": "command",    "windows": ["scripts/windows/module-list.ps1"],      "posix": ["scripts/posix/module-list.sh"] },
    { "name": "list-apis",        "role": "command",    "windows": ["scripts/windows/list-apis.ps1"],        "posix": ["scripts/posix/list-apis.sh"] },
    { "name": "repo-manifest",    "role": "command",    "windows": ["scripts/windows/repo-manifest.ps1"],    "posix": ["scripts/posix/repo-manifest.sh"] },
    { "name": "batch-apply",      "role": "command",    "windows": ["scripts/windows/batch-apply.ps1"],      "posix": ["scripts/posix/batch-apply.sh"] },
    { "name": "preflight",        "role": "command",    "windows": ["scripts/windows/preflight.ps1"],        "posix": ["scripts/posix/preflight.sh"] },
    { "name": "install-templates", "role": "command",   "windows": ["scripts/windows/install-templates.ps1"], "posix": ["scripts/posix/install-templates.sh"] },
    { "name": "scaffold",         "role": "command",    "windows": ["scripts/windows/scaffold.ps1"],         "posix": ["scripts/posix/scaffold.sh"] },
    { "name": "ledger",           "role": "command",    "windows": ["scripts/windows/ledger.ps1"],           "posix": ["scripts/posix/ledger.sh"] },
    { "name": "manifest-write",   "role": "command",    "windows": ["scripts/windows/manifest-write.ps1"],   "posix": ["scripts/posix/manifest-write.sh"] },
    { "name": "census-diff",      "role": "command",    "windows": ["scripts/windows/census-diff.ps1"],      "posix": ["scripts/posix/census-diff.sh"] },
    { "name": "update-preflight", "role": "command",    "windows": ["scripts/windows/update-preflight.ps1"], "posix": ["scripts/posix/update-preflight.sh"] },
    { "name": "hook-ledger-status", "role": "hook",     "windows": ["scripts/windows/hook-ledger-status.ps1"], "posix": ["scripts/posix/hook-ledger-status.sh"] },
    { "name": "hook-stamp-guard", "role": "hook",       "windows": ["scripts/windows/hook-stamp-guard.ps1"], "posix": ["scripts/posix/hook-stamp-guard.sh"] },
    { "name": "hook-size-check",  "role": "hook",       "windows": ["scripts/windows/hook-size-check.ps1"],  "posix": ["scripts/posix/hook-size-check.sh"] }
  ],
  "promptTemplates": [
    { "name": "agent-definition", "file": "prompts/agent-definition.md", "installPath": ".claude/template/agent-definition.md" },
    { "name": "report",           "file": "prompts/report.md",           "installPath": ".claude/template/report.md" },
    { "name": "readme-docs",      "file": "prompts/readme-docs.md",      "installPath": ".claude/template/readme-docs.md" },
    { "name": "readme-tests",     "file": "prompts/readme-tests.md",     "installPath": ".claude/template/readme-tests.md" },
    { "name": "doc-header",       "file": "prompts/doc-header.md",       "installPath": ".claude/template/doc-header.md" }
  ],
  "settingsFragments": {
    "windows": "hooks/settings-fragment.windows.json",
    "posix": "hooks/settings-fragment.posix.json"
  },
  "generatedNotFetched": ["regen-registry", "api-diff"],
  "constants": {
    "locSoftCeiling": 500,
    "docSoftCeiling": 500,
    "registerSoftLimit": 35000,
    "registerCropTrigger": 40000,
    "indexInlineEntries": 100,
    "batchApplyDiffCap": 20000,
    "repoManifestListCap": 100,
    "preflightListCap": 20,
    "censusListCap": 100,
    "manifestWriteDropCap": 20,
    "updatePreflightListCap": 100
  }
}
